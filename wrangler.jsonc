{
  // Cloudflare Workers deployment for Orbit.
  // `npm run build` produces ./dist (static SPA), and the Worker serves the
  // Hono API for /api/* while static assets handle everything else.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Serve only on the custom domain; the *.workers.dev endpoint stays off.
  "workers_dev": false,
  "routes": [
    { "pattern": "orbit.openhub.today", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
