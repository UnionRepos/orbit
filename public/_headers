# Cloudflare static asset headers for the Orbit SPA.
# The service worker must never be served from a stale HTTP cache, while
# content-addressed bundles and PWA icons can be cached forever.

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
