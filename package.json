{
  "name": "orbit",
  "version": "0.1.0",
  "description": "Orbit — a feed-style third-party GitHub client for open-source discovery.",
  "main": "index.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"server/**/*.test.ts\" \"src/**/*.test.ts\"",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.ts",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "worker:dev": "wrangler dev",
    "seed": "node scripts/build-seed.ts",
    "icons": "node scripts/build-icons.ts"
  },
  "keywords": [
    "github",
    "open-source",
    "discovery",
    "react",
    "hono",
    "vite"
  ],
  "author": "lemonhub-io",
  "license": "MIT",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "dompurify": "^3.4.17",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  }
}
